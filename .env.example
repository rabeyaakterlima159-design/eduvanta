# ==============================================================================
# EDUVANTA ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in real production or sandbox values.
# NEVER commit real production keys to version control.

# ------------------------------------------------------------------------------
# SUPABASE PLATFORM CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY: NEVER EXPOSE SERVICE_ROLE KEY IN CLIENT OR MOBILE BUNDLES
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-jwt-secret-for-custom-tokens

# ------------------------------------------------------------------------------
# PLATFORM SETTINGS & APP URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="EDUVANTA"
NEXT_PUBLIC_APP_TAGLINE="One Platform. Every Campus. Smarter Education."
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ------------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=eduvanta-fcm
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@eduvanta-fcm.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...==\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-public-key

# ------------------------------------------------------------------------------
# BANGLADESH PAYMENT GATEWAYS (SANDBOX / PRODUCTION SWITCHABLE)
# ------------------------------------------------------------------------------
# bKash Checkout URL API
BKASH_APP_KEY=sandbox_app_key_placeholder
BKASH_APP_SECRET=sandbox_app_secret_placeholder
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# Nagad API
NAGAD_MERCHANT_ID=sandbox_merchant_id
NAGAD_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
NAGAD_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n..."
NAGAD_BASE_URL=http://sandbox.mymdirect.com:8080/remote-payment-gateway-1.0/api/dfs

# SSLCommerz API
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
